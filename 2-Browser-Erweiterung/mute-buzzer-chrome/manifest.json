{
  "manifest_version": 3,
  "name": "Mute-Buzzer",
  "version": "1.0.4",
  "description": "Mutet mit einem Knopfdruck alle Tabs, die Ton abspielen – und entmutet sie beim nächsten Druck wieder.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mute-Buzzer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+9",
        "mac": "MacCtrl+Shift+9"
      },
      "description": "Ton-Tabs muten / wieder entmuten"
    },
    "toggle-mute": {
      "suggested_key": {
        "default": "Ctrl+Shift+9"
      },
      "description": "Ton-Tabs muten / wieder entmuten",
      "global": true
    }
  }
}